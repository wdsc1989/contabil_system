[Unit]
Description=Sistema Contábil - Streamlit Application
After=network.target postgresql.service

[Service]
Type=simple
User=contabil
Group=contabil
WorkingDirectory=/opt/contabil
Environment="PATH=/opt/contabil/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/contabil/.env

# Comando para iniciar a aplicação
ExecStart=/opt/contabil/venv/bin/streamlit run app.py \
    --server.port=8501 \
    --server.address=127.0.0.1 \
    --server.headless=true \
    --server.enableCORS=false \
    --server.enableXsrfProtection=true \
    --browser.gatherUsageStats=false \
    --server.fileWatcherType=none \
    --server.runOnSave=false

# Reinicia automaticamente em caso de falha
Restart=always
RestartSec=10

# Limites de recursos (aumentados para processamento de imagens)
LimitNOFILE=65536
MemoryMax=4G
MemoryHigh=3G
# Timeout para operações longas (Vision API pode demorar)
TimeoutStopSec=300

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=contabil

[Install]
WantedBy=multi-user.target







